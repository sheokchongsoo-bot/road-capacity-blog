# 릴리스 서명 설정 예시.
# 이 파일을 복사해 android/keystore.properties 로 저장하고 값을 채운다(이 파일은 git 에 커밋 금지).
#
# 키스토어 생성(최초 1회):
#   keytool -genkeypair -v -keystore oimarket-release.jks \
#     -alias oimarket -keyalg RSA -keysize 2048 -validity 10000
#
# ⚠️ 이 키스토어와 비밀번호는 반드시 안전하게 백업/보관하세요.
#    분실 시 기존 설치본을 업데이트할 수 없습니다(같은 키로만 업데이트 가능).

storeFile=/절대/경로/oimarket-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=oimarket
keyPassword=여기에_키_비밀번호
