<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 기본 앱 테마 (라이트/다크 자동) -->
    <style name="Theme.OiMarket" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand_green</item>
        <item name="android:navigationBarColor">@color/brand_green_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 스플래시(Android 12+ SplashScreen API) -->
    <style name="Theme.OiMarket.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OiMarket</item>
    </style>
</resources>
